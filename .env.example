# Mverify/Mcore 0.16.0 host-local example. Copy outside the repository and chmod 600.
MCORE_HOST=127.0.0.1
MCORE_PORT=8765
MCORE_HOME=/var/lib/mcore
OLLAMA_HOST=http://127.0.0.1:11434
MCORE_MODEL=qwen2.5-coder:14b
MCORE_EMBEDDING_MODEL=nomic-embed-text:latest
MCORE_REQUEST_TIMEOUT=240
MCORE_EMBEDDING_TIMEOUT=30
MCORE_MAX_REQUEST_BYTES=4194304
MCORE_CONTEXT_MAX_CHARS=18000
MCORE_API_URL=http://127.0.0.1:8765/api/v1
# Optional output location; default is .mverify-validation in the release checkout.
# Set project paths only on RHEL after review. Never add proprietary source to Git.
# MVERIFY_ALLOWED_PROJECT_ROOTS=/server/designs/approved
# MVERIFY_RTL_PROJECT=/server/designs/approved/project_a
# MVERIFY_DUT_TOP=approved_top


# Hybrid inference is disabled by default. Enable only after approving the provider.
MCORE_CLOUD_ENABLED=false
MCORE_CLOUD_BASE_URL=
MCORE_CLOUD_API_KEY=
MCORE_CLOUD_MODEL=
MCORE_CLOUD_TIMEOUT=180
